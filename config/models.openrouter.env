# Hosted alternative to config/models.env: the same models, served by
# OpenRouter instead of local llama.cpp servers. For anyone who can't run the
# local setup. Select it in .env:
#
#   MEMRECON_MODELS=config/models.openrouter.env
#   OPENROUTER_API_KEY=<your key>
#   MEMRECON_ALLOW_PAID=1        # these calls cost money; the client refuses them otherwise
#
# Differences from the local setup (see README, "How the models are run"):
# the hosted weights are not the 4-bit files used locally (OpenRouter does not
# state the precision), the serving software differs, and seeds may be
# ignored, so answers will be close to but not identical with local runs.
# Each role is pinned to one hosting company (HOST) with no fallback, so a
# run doesn't silently switch between companies; change HOST if it is down.
# Thinking is turned off with OpenRouter's reasoning setting (effort "none").
#
# Per role: _KIND chat; _PROVIDER openrouter; _URL the API address;
# _NAME OpenRouter's model ID; _HOST the hosting company's slug on OpenRouter;
# _KEY_ENV the .env variable holding the key (never the key itself).
# Retrieval embeddings have no hosted role yet; that is decided when
# retrieval is built.

# agent: same model as D15 (Qwen3.6-35B-A3B)
AGENT_KIND=chat
AGENT_PROVIDER=openrouter
AGENT_URL=https://openrouter.ai/api/v1
AGENT_NAME=qwen/qwen3.6-35b-a3b
AGENT_HOST=deepinfra
AGENT_KEY_ENV=OPENROUTER_API_KEY

# judge: same model as D16 (Gemma 4 26B-A4B)
JUDGE_KIND=chat
JUDGE_PROVIDER=openrouter
JUDGE_URL=https://openrouter.ai/api/v1
JUDGE_NAME=google/gemma-4-26b-a4b-it
JUDGE_HOST=deepinfra
JUDGE_KEY_ENV=OPENROUTER_API_KEY
