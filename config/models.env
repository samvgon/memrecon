# Which model serves each role. Read by scripts/serve.sh (to start servers)
# and by src/memrecon/llm.py (to call them). Code only ever asks for a role.
#
# To swap a model: change that role's lines, restart its server
# (scripts/serve.sh stop <role>; scripts/serve.sh <role>), and add a
# decision-log entry with the new file's sha256.
#
# Per role (ROLE in capitals, "-" written as "_"):
#   _KIND  chat or embed
#   _FILE  the .gguf file, loaded by path (no download)
#   _NAME  the model name the server reports and every saved call records
#   _PORT  local port; the client calls http://localhost:<PORT>/v1
#   _CTX   context size (-c)
# A role's URL or name can be overridden for one machine in .env
# (MEMRECON_<ROLE>_URL, MEMRECON_<ROLE>_MODEL); see .env.example.

# agent: D15
AGENT_KIND=chat
AGENT_FILE=~/.cache/huggingface/hub/models--unsloth--Qwen3.6-35B-A3B-GGUF/snapshots/a483e9e6cbd595906af30beda3187c2663a1118c/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
AGENT_NAME=qwen3.6-35b-a3b-ud-q4_k_m
AGENT_PORT=8080
AGENT_CTX=131072

# judge: D16
JUDGE_KIND=chat
JUDGE_FILE=~/.cache/huggingface/hub/models--unsloth--gemma-4-26B-A4B-it-GGUF/snapshots/c099eb48e663fd284577b04978a94ffccb261841/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
JUDGE_NAME=gemma-4-26b-a4b-it-ud-q4_k_m
JUDGE_PORT=8081
JUDGE_CTX=16384

# embed: retrieval (D17, D37); used by ingestion, recall and answering
EMBED_KIND=embed
EMBED_FILE=~/models/nomic-embed-text-v1.5.Q8_0.gguf
EMBED_NAME=nomic-embed-text-v1.5-q8_0
EMBED_PORT=8082
EMBED_CTX=8192
# nomic-embed-text-v1.5 expects a task prefix on every text (its model card):
# "search_query: " for what is searched with, "search_document: " for what is searched.
EMBED_QUERY_PREFIX=search_query:
EMBED_DOC_PREFIX=search_document:

# agent-small: stretch goal (second model size, D15); not used yet.
# Qwen3-8B's native context is 32k, too short for the full-history baseline.
AGENT_SMALL_KIND=chat
AGENT_SMALL_FILE=~/models/Qwen3-8B-Q4_K_M.gguf
AGENT_SMALL_NAME=qwen3-8b-q4_k_m
AGENT_SMALL_PORT=8083
AGENT_SMALL_CTX=32768
