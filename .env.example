# Copy this file to .env (git-ignored) and uncomment what you need.
# Never commit a real key.

# --- Hosted models (OpenRouter) instead of local servers ----------------------
# These calls cost money; the client refuses them unless MEMRECON_ALLOW_PAID=1.
# (For Sam's own runs: only with explicit approval, decision D05.)
# MEMRECON_MODELS=config/models.openrouter.env
# OPENROUTER_API_KEY=
# MEMRECON_ALLOW_PAID=1
# MEMRECON_BUDGET_USD=5        # stop paid calls once recorded spend reaches this

# --- Overrides for one machine -------------------------------------------------
# Which model serves each role belongs in config/models*.env, not here. Use
# these only if, say, a server runs on another host or port.
# MEMRECON_AGENT_URL=http://localhost:8080/v1
# MEMRECON_AGENT_MODEL=qwen3.6-35b-a3b-ud-q4_k_m
# MEMRECON_JUDGE_URL=http://localhost:8081/v1
# MEMRECON_JUDGE_MODEL=gemma-4-26b-a4b-it-ud-q4_k_m
# (roles with a hyphen use an underscore: MEMRECON_AGENT_SMALL_URL)

# --- Labels -------------------------------------------------------------------
# Default tag written to the ledger for calls that don't set one.
# MEMRECON_TAG=
